<?xml version="1.0" encoding="utf-8"?>
<!--
    修 5:之前这里只有一个 FrameLayout + ImageView,游戏标题是靠系统 ActionBar
    (主题是 Theme.AppCompat.DayNight,带 ActionBar) 显示的。配合 EmulationActivity 的
    enableFullscreenImmersive() 后,系统 ActionBar 不会自动跟着 hide(),导致
    顶部那个黄条一直盖在游戏画面上,游戏画面被压一截(看截图 3 那条黄 "The Legend of Zelda...")。

    改成 NoActionBar 主题 + 自己塞一个 androidx Toolbar:
      - Toolbar 用 setSupportActionBar() 注入,菜单/标题功能照旧
      - Toolbar 的 fitsSystemWindows="true" 让它自动让出状态栏高度
      - enableFullscreenImmersive() 隐藏 system bars 时顺便 toolbar.setVisibility(GONE)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/frame_emulation_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/image_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="image_game_icon" />

    <!-- 自定义 Toolbar,替代之前系统 ActionBar。这样 enableFullscreenImmersive
         hide(systemBars()) 之后我们手动 toolbar.setVisibility(GONE) 就能一起消失。 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_emulation"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="4dp" />

</FrameLayout>
